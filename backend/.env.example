# Swasth Setu Backend Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://swasth_user:swasth_pass_2026@localhost:5432/swasth_setu_db?schema=public&sslmode=prefer"

# JWT Secrets & Expirations
JWT_ACCESS_SECRET="swasth_setu_jwt_access_secret_sih_2026_super_secure_key"
JWT_REFRESH_SECRET="swasth_setu_jwt_refresh_secret_sih_2026_long_lived_key"
JWT_ACCESS_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="7d"

# Microservices Communication
AI_SERVICE_URL="http://localhost:8000"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
